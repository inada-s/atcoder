    "topological sort": {
        "scope": "cpp",
        "prefix": "_toposort",
        "body": [
            "// トポロジカルソート (Kahn 法、クラス、main の外に置く)。頂点は任意の型 V。結果は辞書順最小",
            "template <class V>",
            "struct Toposort {",
            "    vector<V> order;",
            "    bool has_cycle = false;  // order.size() < 頂点数 なら閉路あり",
            "    // vs: 全頂点 (vector<int> や views::iota(0, n))。next(v, add): v から出る辺の先ごとに add(to)",
            "    void run(auto&& vs, auto&& next) {",
            "        map<V, int> indeg;",
            "        for (V v : vs) indeg[v];",
            "        for (V v : vs) next(v, [&](V to) { indeg[to]++; });",
            "        priority_queue<V, vector<V>, greater<V>> q;  // 辞書順最小。順序を問わないなら queue<V> にして q.front() (少し速い)",
            "        for (auto& [v, d] : indeg) if (d == 0) q.push(v);",
            "        while (!q.empty()) {",
            "            V v = q.top();",
            "            q.pop();",
            "            order.push_back(v);",
            "            next(v, [&](V to) { if (--indeg[to] == 0) q.push(to); });",
            "        }",
            "        has_cycle = order.size() < indeg.size();",
            "    }",
            "};",
            "// 使い方: Toposort<int> ts;",
            "//         ts.run(views::iota(0, n), [&](int v, auto add) { for (int u : g[v]) add(u); });",
            "//         ts.order, ts.has_cycle"
        ],
        "description": "トポロジカルソート (クラス、main の外に置く、辞書順最小)。頂点は任意の型。ts.run(全頂点, 隣接ラムダ) → ts.order / ts.has_cycle"
    },
    "cycle detection": {
        "scope": "cpp",
        "prefix": "_cycle",
        "body": [
            "// 閉路検出 (DFS、クラス、main の外に置く)。頂点は任意の型 V。有向・無向どちらも",
            "template <class V>",
            "struct Cycle {",
            "    bool directed;",
            "    map<V, int> state;  // 1 = 探索中, 2 = 完了 (未訪問は無し)",
            "    vector<V> path, cycle;  // cycle: 見つけた閉路の頂点列 (無ければ空)",
            "    Cycle(bool directed) : directed(directed) {}",
            "    bool dfs(V v, const V* par, auto&& next) {",
            "        state[v] = 1;",
            "        path.push_back(v);",
            "        bool found = false;",
            "        next(v, [&](V to) {",
            "            if (found) return;",
            "            if (!directed && par && to == *par) return;  // 無向: 親へ戻る辺は無視 (多重辺を閉路と数えるなら辺番号で判定)",
            "            auto it = state.find(to);",
            "            int st = it == state.end() ? 0 : it->second;",
            "            if (st == 2) return;",
            "            if (st == 1) {  // 探索中の頂点に戻った = 閉路",
            "                cycle.assign(find(path.begin(), path.end(), to), path.end());",
            "                found = true;",
            "                return;",
            "            }",
            "            if (dfs(to, &v, next)) found = true;",
            "        });",
            "        if (found) return true;",
            "        path.pop_back();",
            "        state[v] = 2;",
            "        return false;",
            "    }",
            "    // vs: 全頂点 (vector<int> や views::iota(0, n))。next(v, add): v から出る辺の先ごとに add(to)",
            "    void run(auto&& vs, auto&& next) {",
            "        for (V v : vs) if (!state.count(v) && dfs(v, nullptr, next)) break;",
            "    }",
            "    bool has_cycle() const { return !cycle.empty(); }",
            "};",
            "// 使い方: Cycle<int> cy(true);  // 有向なら true、無向なら false",
            "//         cy.run(views::iota(0, n), [&](int v, auto add) { for (int u : g[v]) add(u); });",
            "//         cy.has_cycle(), cy.cycle"
        ],
        "description": "閉路検出 (クラス、main の外に置く)。頂点は任意の型。Cycle<V> cy(有向?); cy.run(全頂点, 隣接ラムダ) → cy.has_cycle() / cy.cycle (閉路を 1 つ復元)"
    },
    "union find": {
        "scope": "cpp",
        "prefix": "_uf",
        "body": [
            "struct UnionFind {",
            "    vector<int> p;  // 根なら -(サイズ)、それ以外は親",
            "    UnionFind(int n) : p(n, -1) {}",
            "    int find(int x) { return p[x] < 0 ? x : p[x] = find(p[x]); }",
            "    bool same(int x, int y) { return find(x) == find(y); }",
            "    int size(int x) { return -p[find(x)]; }",
            "    bool unite(int x, int y) {",
            "        x = find(x), y = find(y);",
            "        if (x == y) return false;",
            "        if (p[x] > p[y]) swap(x, y);  // 大きい方に小さい方をつなぐ",
            "        p[x] += p[y];",
            "        p[y] = x;",
