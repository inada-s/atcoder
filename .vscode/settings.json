{
    // ---- CPH (Competitive Programming Helper) ----
    // リポジトリの場所に依存する 3 つ (テンプレートの場所、サンプルの保存先、C++ のオプションの -I) は
    // ここではなく tools/setup.sh がマシン設定に書く。clone したら ./tools/setup.sh を 1 回実行する。
    "cph.general.defaultLanguage": "cpp",
    "cph.general.doTemplateFileVariableReplacement": true,
    "cph.general.useShortAtCoderName": true,
    "cph.general.timeOut": 4000,
    "cph.general.menuChoices": "cpp python",
    "cph.language.cpp.Command": "g++-15",
    "cph.language.python.Command": "python3",

    // ---- エディタ ----
    "files.exclude": {
        ".cph": true,
        "**/*.bin": true
    },
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // ---- デバッグ ----
    // 止まったときに各行の右側へ変数の値を表示する (ホバー不要)
    "debug.inlineValues": "on",
    "debug.showBreakpointsInOverviewRuler": true,

    // ---- 補完 (clangd) ----
    // Microsoft C/C++ 拡張の IntelliSense は止めて clangd に任せる (両方動くと二重に出る)
    "C_Cpp.intelliSenseEngine": "disabled",
    // clangd 本体は PATH 上のもの (~/.local/bin/clangd、公式バイナリ)。フラグは compile_flags.txt
    "clangd.arguments": ["--header-insertion=never", "--background-index"]
}
