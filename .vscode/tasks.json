{
    "version": "2.0.0",
    "tasks": [
        {
            // デバッグ用ビルド。最適化なし + デバッグ情報 + STL の範囲チェック (_GLIBCXX_DEBUG)
            "label": "build debug",
            "type": "shell",
            "command": "${config:cph.language.cpp.Command}",  // tools/setup.sh が書く g++-NN のフルパス
            "args": [
                "-std=gnu++23", "-g", "-O0", "-DLOCAL", "-D_GLIBCXX_DEBUG",
                "-I${workspaceFolder}/lib/ac-library", "-I${workspaceFolder}/lib", "-isystem${workspaceFolder}/lib/boost",
                "${file}", "-o", "${workspaceFolder}/.cph/${fileBasenameNoExtension}.debug"
            ],
            // $gcc は Microsoft C/C++ 拡張が提供するもので、入っていないと使えないので同じものを書いておく
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            },
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            // CPH のテストケース (番号を聞く) の入力を in.txt に書き出す
            "label": "cph testcase -> in.txt",
            "type": "shell",
            "command": "python3",
            "args": ["${workspaceFolder}/tools/cph_input.py", "${file}", "${input:testcase}"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "clear": true, "focus": false }
        },
        {
            // 上の 2 つを順に実行する (launch.json の「Debug (CPH testcase)」が使う)
            "label": "debug: cph testcase",
            "dependsOn": ["cph testcase -> in.txt", "build debug"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testcase",
            "type": "promptString",
            "description": "CPH のテストケース番号 (1 始まり)",
            "default": "1"
        }
    ]
}
