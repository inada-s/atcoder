# 解答はコミットしない (Competitive Companion / CPH がルートに作る)
/*.cpp
/*.py
!/template.cpp

# CPH のサンプル (.prob) とビルド成果物
.cph/
*.bin
a.out

# デバッグ実行の入力 (launch.json が stdin に流す)
/in.txt

# tools/setup.sh が書く clangd の設定 (g++ のパスがマシンごとに違う)
/.clangd

# tools/setup.sh が張る Boost へのリンク (実体は ~/.local/opt/boost_*。-isystem で読む)
/lib/boost
