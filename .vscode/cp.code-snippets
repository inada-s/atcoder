    "dijkstra": {
        "scope": "cpp",
        "prefix": "_dijkstra",
        "body": [
            "// ダイクストラ (クラス、main の外に置く)。頂点は任意の型 V (int, pair, tuple<int, int, bool> など。== 比較できれば何でも)",
            "// グラフは持たない。隣接の列挙は run に渡すラムダで行うので、グリッドや状態付きの探索も同じ形で書ける",
            "using ull = unsigned long long;",
            "template <class V>",
            "struct Dijkstra {",
            "    // 何でもハッシュ (整数, pair, tuple, string と入れ子)。V が自作 struct なら tuple にするか自前の hash を",
            "    struct Hash {",
            "        static ull mix(ull x) {  // splitmix64",
            "            x += 0x9e3779b97f4a7c15;",
            "            x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;",
            "            x = (x ^ (x >> 27)) * 0x94d049bb133111eb;",
            "            return x ^ (x >> 31);",
            "        }",
            "        static inline const ull SEED = chrono::steady_clock::now().time_since_epoch().count();  // hack 対策",
            "        template <class T>",
            "        size_t operator()(const T& v) const {",
            "            if constexpr (is_integral_v<T> || is_enum_v<T>) return mix((ull)v + SEED);",
            "            else if constexpr (requires { tuple_size<T>::value; }) {  // pair, tuple, array",
            "                ull h = SEED;",
            "                apply([&](const auto&... e) { ((h = mix(h ^ (*this)(e))), ...); }, v);",
            "                return h;",
            "            } else return hash<T>{}(v);",
            "        }",
            "    };",
            "    struct State {",
            "        ll d;",
            "        V v;",
            "        bool operator>(const State& o) const { return d > o.d; }",
            "    };",
            "    struct Info {",
            "        ll d;    // 距離",
            "        V from;  // 経路復元用の 1 つ前の頂点 (始点は自分自身)",
            "    };",
            "    ll INF = 1LL << 60;",
            "    unordered_map<V, Info, Hash> info;  // 到達した頂点だけ入る",
            "    priority_queue<State, vector<State>, greater<State>> pq;",
            "    Dijkstra(size_t n = 0) { info.reserve(n); }  // ★ 頂点数の見込みを渡すと再ハッシュが減って速い",
            "    void push(V s, ll d = 0) { push({d, s}, s); }  // ★ 始点を登録 (複数始点なら繰り返し呼ぶ)。run の前に",
            "    void push(State s, V from) {",
            "        auto [it, inserted] = info.try_emplace(s.v, Info{s.d, from});",
            "        if (!inserted) {",
            "            if (s.d >= it->second.d) return;  // ★ 更新判定 (より短いときだけ)",
            "            it->second = {s.d, from};",
            "        }",
            "        pq.push(s);",
            "    }",
            "    // next(v, add): v から行ける先ごとに add(to, cost) を呼ぶ。★ 遷移条件とコストの計算はこのラムダに書く",
            "    void run(auto&& next) {",
            "        while (!pq.empty()) {",
            "            State cur = pq.top();",
            "            pq.pop();",
            "            if (cur.d > info.find(cur.v)->second.d) continue;  // 古い情報は捨てる",
            "            next(cur.v, [&](V to, ll cost) { push({cur.d + cost, to}, cur.v); });",
            "        }",
            "    }",
            "    ll get(V v) const {  // 距離 (未到達は INF)",
            "        auto it = info.find(v);",
            "        return it == info.end() ? INF : it->second.d;",
            "    }",
            "    bool reachable(V v) const { return info.contains(v); }",
            "    vector<V> path(V t) const {  // 始点から t までの頂点列 (到達不能なら空)",
            "        if (!reachable(t)) return {};",
            "        vector<V> res;",
            "        for (V v = t;; v = info.at(v).from) {",
            "            res.push_back(v);",
            "            if (info.at(v).from == v) break;",
            "        }",
            "        reverse(res.begin(), res.end());",
            "        return res;",
            "    }",
            "};",
            "// 使い方 (隣接リスト g):",
            "//   Dijkstra<int> dij(n);",
            "//   dij.push(s);",
            "//   dij.run([&](int v, auto add) { for (auto& e : g[v]) add(e.to, e.cost); });",
            "// 使い方 (グリッド、S[y][x] == '#' が壁):",
            "//   Dijkstra<pair<int, int>> dij(H * W);",
            "//   dij.push({sy, sx});",
            "//   dij.run([&](auto p, auto add) {",
            "//       auto [y, x] = p;",
            "//       rep(k, 4) {",
            "//           int ny = y + dy[k], nx = x + dx[k];",
            "//           if (ny < 0 || ny >= H || nx < 0 || nx >= W || S[ny][nx] == '#') continue;",
            "//           add({ny, nx}, 1);",
            "//       }",
            "//   });",
            "// 結果: dij.get(v) 距離 (未到達は INF), dij.reachable(v), dij.path(t)"
        ],
        "description": "ダイクストラ (クラス、main の外に置く)。頂点は任意の型 (tuple も可、ハッシュ内蔵の unordered_map)。Dijkstra<V> dij(頂点数の見込み); dij.push(始点); dij.run(隣接ラムダ) (グリッドも可)。dij.get(v) / reachable(v) / path(t)"
    },
